<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Soluciones digitales claras, rápidas y listas para usar. Servicios exprés de CONEXA desde 39€." />
    <meta name="theme-color" content="#020617" />
    <title><%= pageTitle %></title>
    <link rel="icon" href="/images/favicon.jpeg" type="image/jpeg" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap">
    <link rel="stylesheet" href="/css/styles.css" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ["DM Sans", "ui-sans-serif", "system-ui", "sans-serif"],
              display: ["Space Grotesk", "ui-sans-serif", "system-ui", "sans-serif"],
            },
            colors: {
              ink: "#020617",
              teal: "#84cc16",
              mist: "#f8fafc",
              coral: "#0f172a",
            },
          },
        },
      };
    </script>
  </head>

<style>
:root {
  color-scheme: light;
  --ink: #020617;
  --teal: #84cc16;
  --mist: #f8fafc;
  --coral: #0f172a;
}

html {
  scroll-behavior: smooth;
}

body {
  background:
    radial-gradient(circle at 83% 8%, rgba(132, 204, 22, 0.1), transparent 23rem),
    var(--mist);
}

.font-display {
  font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
}

.hero-orb::before {
  position: absolute;
  z-index: -1;
  top: 0;
  right: -9rem;
  width: 31rem;
  height: 31rem;
  border: 1px solid rgba(132, 204, 22, 0.18);
  border-radius: 999px;
  content: "";
}

.hero-orb::after {
  position: absolute;
  z-index: -1;
  top: 5rem;
  right: -3rem;
  width: 18rem;
  height: 18rem;
  border-radius: 999px;
  background: rgba(132, 204, 22, 0.1);
  content: "";
}

.hero-note {
  width: 270px;
  min-height: 315px;
  padding: 1.3rem;
  border: 1px solid rgba(11, 31, 51, 0.1);
  border-radius: 1.25rem;
  background: rgba(255, 255, 255, 0.55);
  box-shadow: 0 25px 80px rgba(11, 31, 51, 0.08);
  transform: rotate(4deg);
}

.catalog-section {
  padding: 1.25rem;
  border: 1px solid rgba(11, 31, 51, 0.06);
  border-radius: 1.75rem;
}

.catalog-section--web {
  background: rgba(255, 255, 255, 0.72);
}

.catalog-section--growth {
  background: rgba(249, 250, 250, 0.9);
}

.catalog-section--brand {
  background: rgba(239, 249, 247, 0.72);
}

.catalog-section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1rem;
  padding: 0.25rem 0.25rem 0.75rem;
}

.section-number {
  display: inline-flex;
  height: 2.5rem;
  width: 2.5rem;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 0.75rem;
  background: var(--ink);
  color: white;
  font-family: "Space Grotesk", sans-serif;
  font-size: 0.9rem;
  font-weight: 600;
}

.service-grid {
  display: flex;
  gap: 0.75rem;
  overflow-x: auto;
  padding: 0.15rem 0.15rem 0.5rem;
  cursor: grab;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
}

.service-grid.is-dragging {
  cursor: grabbing;
  user-select: none;
}

.service-grid::-webkit-scrollbar {
  display: none;
}

.service-card {
  display: flex;
  min-height: 286px;
  min-width: calc(100% - 2.75rem);
  flex-direction: column;
  justify-content: space-between;
  padding: 1rem;
  border-radius: 1.25rem;
  background: rgba(255, 255, 255, 0.6);
  scroll-snap-align: start;
  transition: transform 300ms ease, box-shadow 300ms ease, background 300ms ease;
}

.service-card:hover {
  background: #fff;
  transform: translateY(-5px);
}

.tier-dot {
  display: block;
  height: 0.55rem;
  width: 0.55rem;
  flex: 0 0 auto;
  border-radius: 999px;
}

.tier-bajo,
.tier-medio,
.tier-alto { background: var(--teal); }

.process-step span {
  display: block;
  margin-bottom: 1.6rem;
  color: var(--teal);
  font-family: "Space Grotesk", sans-serif;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.process-step h3 {
  margin-bottom: 0.5rem;
  font-family: "Space Grotesk", sans-serif;
  font-size: 1.25rem;
  font-weight: 600;
  letter-spacing: -0.04em;
}

.process-step p {
  max-width: 13rem;
  color: rgba(11, 31, 51, 0.5);
  font-size: 0.875rem;
  line-height: 1.6;
}

.request-panel {
  box-shadow: 0 28px 80px rgba(11, 31, 51, 0.18);
}

.request-shape {
  position: absolute;
  border: 1px solid rgba(21, 184, 166, 0.45);
  border-radius: 999px;
}

.request-shape-one {
  right: -7rem;
  top: -9rem;
  height: 30rem;
  width: 30rem;
}

.request-shape-two {
  bottom: -10rem;
  right: 8rem;
  height: 22rem;
  width: 22rem;
  border-color: rgba(15, 23, 42, 0.45);
}

.reveal {
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 700ms ease, transform 700ms ease;
}

.reveal.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.service-card.reveal.is-visible {
  transition-delay: var(--delay, 0ms);
}

.reveal-delay {
  transition-delay: 160ms;
}

.legal-content .eyebrow {
  margin-bottom: 1rem;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.legal-content h1 {
  max-width: 46rem;
  margin: 0;
  font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
  font-size: clamp(2.7rem, 7vw, 5rem);
  font-weight: 600;
  line-height: 0.98;
  letter-spacing: -0.07em;
}

.legal-content .legal-intro {
  margin-top: 1.5rem;
  max-width: 40rem;
  color: rgba(11, 31, 51, 0.62);
  font-size: 1.15rem;
  line-height: 1.8;
}

.legal-content h2 {
  margin-top: 3rem;
  margin-bottom: 0.8rem;
  font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
  font-size: 1.45rem;
  font-weight: 600;
  letter-spacing: -0.04em;
}

.legal-content p,
.legal-content li {
  color: rgba(11, 31, 51, 0.68);
  font-size: 1rem;
  line-height: 1.8;
}

.legal-content p + p {
  margin-top: 0.9rem;
}

.legal-content ul {
  display: grid;
  gap: 0.7rem;
  margin-top: 1rem;
  padding-left: 1.25rem;
}

.legal-content li {
  padding-left: 0.25rem;
}

.legal-content li::marker {
  color: var(--teal);
}

.legal-content a {
  color: var(--teal);
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 0.2em;
}

.eyebrow {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.about-method-card {
  min-height: 260px;
  padding: 1.5rem;
  border: 1px solid rgba(11, 31, 51, 0.08);
  border-radius: 1.5rem;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18px 50px rgba(11, 31, 51, 0.05);
}

.about-method-card:nth-child(2) {
  background: rgba(239, 249, 247, 0.72);
}

.about-method-card:nth-child(3) {
  background: rgba(247, 254, 231, 0.86);
}

.about-method-card__number {
  display: block;
  margin-bottom: 3.5rem;
  color: var(--teal);
  font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.about-method-card h3 {
  margin-bottom: 0.6rem;
  font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
  font-size: 1.45rem;
  font-weight: 600;
  letter-spacing: -0.04em;
}

.about-method-card p {
  max-width: 18rem;
  color: rgba(11, 31, 51, 0.58);
  font-size: 0.95rem;
  line-height: 1.65;
}

.success-shell {
  position: relative;
}

.success-shell::before {
  position: absolute;
  z-index: -1;
  top: -7rem;
  right: -14rem;
  height: 30rem;
  width: 30rem;
  border: 1px solid rgba(21, 184, 166, 0.14);
  border-radius: 999px;
  content: "";
}

.success-check {
  display: inline-flex;
  height: 5rem;
  width: 5rem;
  align-items: center;
  justify-content: center;
  border-radius: 1.5rem;
  background: var(--teal);
  color: var(--ink);
  font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
  font-size: 2.5rem;
  font-weight: 700;
  box-shadow: 0 16px 40px rgba(21, 184, 166, 0.22);
}

.success-message {
  max-width: 38rem;
  padding: 1.25rem 1.5rem;
  border-left: 4px solid var(--teal);
  border-radius: 0 1rem 1rem 0;
  background: rgba(255, 255, 255, 0.7);
  color: rgba(11, 31, 51, 0.7);
  font-size: 1.15rem;
  line-height: 1.8;
}

.success-step {
  display: grid;
  grid-template-columns: 2.5rem 1fr;
  gap: 1rem;
  align-items: start;
  padding: 1.15rem 0;
  border-bottom: 1px solid rgba(11, 31, 51, 0.08);
}

.success-step span {
  color: var(--teal);
  font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.1em;
}

.success-step p {
  color: rgba(11, 31, 51, 0.68);
  font-size: 1rem;
  line-height: 1.7;
}

@media (min-width: 1024px) {
  .catalog-section {
    padding: 1.5rem;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: visible;
    padding: 0.15rem;
  }

  .service-card {
    min-width: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .reveal { opacity: 1; transform: none; transition: none; }
  .service-card, .service-action { transition: none; }
}
</style>

  </head>
      <body class="bg-mist text-slate-950 antialiased">
    <div class="min-h-screen overflow-hidden">
      <header class="sticky top-0 z-50 border-b border-ink/5 bg-mist/90 backdrop-blur-md">
        <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-7 lg:px-10">
         <a href="/" class="group inline-flex items-center gap-3" aria-label="CONEXA, inicio">
            <img 
              src="/images/logo-conexa.webp" 
              alt="CONEXA Logo" 
              width="120" 
              height="65" 
              fetchpriority="high"
              class="h-8 md:h-10 w-auto mix-blend-multiply" 
            />
          </a>
          <div class="hidden items-center gap-8 text-sm font-semibold text-ink/65 md:flex">
            <a class="transition-colors hover:text-ink" href="#servicios">Servicios</a>
            <a class="transition-colors hover:text-ink" href="#como-funciona">Cómo funciona</a>
            <a class="transition-colors hover:text-ink" href="/sobre-conexa">Quiénes somos</a>
          </div>
          <a
            href="#servicios"
            class="rounded-full bg-lime-400 px-5 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-lime-400/20 transition-all hover:-translate-y-0.5 hover:bg-lime-500"
          >
            Ver soluciones
          </a>
        </nav>
      </header>

      <main>
        <section class="hero-orb relative mx-auto max-w-7xl px-6 pb-20 pt-10 lg:px-10 lg:pb-28 lg:pt-20">
          <div class="grid items-end gap-12 lg:grid-cols-[1fr_0.72fr]">
            <div class="reveal max-w-3xl">
              <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-lime-500/20 bg-white/70 px-3.5 py-2 text-xs font-bold uppercase tracking-[0.18em] text-lime-500">
                <span class="h-2 w-2 rounded-full bg-lime-500"></span>
                Soluciones listas para activar
              </p>
              <h1 class="font-display text-5xl font-extrabold leading-[0.96] tracking-[-0.07em] text-slate-950 sm:text-7xl lg:text-[6.9rem]">
                Tu siguiente<br />
                <span class="text-lime-500">avance digital.</span>
              </h1>
              <p class="mt-8 max-w-xl text-lg leading-8 text-ink/60 sm:text-xl">
                Servicios digitales concretos, sin rodeos y con entregas en 24–48h. Elige lo que necesitas y vuelve a avanzar.
              </p>
              <div class="mt-9 flex flex-wrap items-center gap-4">
                <a
                  href="#servicios"
                  class="inline-flex items-center gap-3 rounded-full bg-lime-400 px-6 py-3.5 text-sm font-bold text-slate-950 transition-all hover:-translate-y-1 hover:bg-lime-500"
                >
                  Explorar servicios
                  <span aria-hidden="true">↘</span>
                </a>
                <span class="text-sm font-medium text-ink/45">Precios claros · Entrega rápida</span>
              </div>
            </div>
            <div class="reveal reveal-delay hidden justify-self-end lg:flex">
              <div class="hero-note">
                <div class="flex items-center justify-between text-xs font-bold uppercase tracking-[0.16em] text-ink/45">
                  <span>CONEXA </span>
                  <span>2026</span>
                </div>
                <div class="mt-20">
                  <div class="mb-4 flex items-center gap-2 text-sm font-semibold text-lime-500">
                    <span class="h-2 w-2 rounded-full bg-lime-500"></span>
                    Disponible ahora
                  </div>
                  <p class="font-display text-3xl font-semibold leading-tight tracking-[-0.05em] text-ink">
                    Menos espera.<br />Más hecho.
                  </p>
                </div>
                <div class="mt-auto flex items-center justify-between border-t border-slate-100 pt-4">
                  <p class="text-xs font-semibold leading-tight text-slate-500">Entrega en 24–48h.<br /><span class="font-bold text-slate-900">Sin reuniones.</span></p>
                  <span class="text-lg font-bold text-lime-500">↗</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <% const catalogSections = [
          { number: "1", title: "Web & Rendimiento", category: "Web & Rendimiento", style: "catalog-section--web" },
          { number: "2", title: "Captación & Automatización", category: "Captación & Automatización", style: "catalog-section--growth" },
          { number: "3", title: "Marca & Legal", category: "Marca & Legal", style: "catalog-section--brand" }
        ]; %>
        <section id="servicios" class="mx-auto max-w-7xl scroll-mt-24 px-6 pb-24 lg:px-10">
          <div class="mb-10 flex flex-col justify-between gap-5 border-t border-ink/10 pt-6 sm:flex-row sm:items-end">
            <div>
              <p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-lime-500">Catálogo exprés</p>
              <h2 class="font-display text-3xl font-extrabold tracking-[-0.055em] text-slate-950 sm:text-4xl">Elige tu próximo paso.</h2>
            </div>
            <p class="max-w-xs text-sm leading-6 text-ink/50">Soluciones pensadas para resolver una necesidad real, hoy.</p>
          </div>

          <div class="space-y-5">
            <% catalogSections.forEach((section, sectionIndex) => { %>
              <section class="catalog-section <%= section.style %>">
                <div class="catalog-section__header">
                  <div class="flex items-center gap-3">
                    <span class="section-number bg-slate-950"><%= section.number %></span>
                    <div>
                      <p class="text-xs font-bold uppercase tracking-[0.18em] text-ink/45">Bloque <%= section.number %></p>
                      <h3 class="mt-1 font-display text-2xl font-extrabold tracking-[-0.055em] text-slate-950 sm:text-3xl"><%= section.title %></h3>
                    </div>
                  </div>
                  <span class="hidden text-xs font-semibold uppercase tracking-[0.15em] text-ink/35 sm:block">3 soluciones</span>
                </div>
                <div class="service-grid">
                  <% services.filter((service) => service.category === section.category).forEach((service, index) => { %>
                    <article class="service-card group reveal border border-gray-200 shadow-sm hover:shadow-md" style="--delay: <%= (sectionIndex * 3 + index) * 55 %>ms">
                      <div class="flex items-start justify-end">
                        <span class="tier-dot tier-<%= service.tier.toLowerCase() %>" title="Nivel <%= service.tier %>" aria-label="Nivel <%= service.tier %>"></span>
                      </div>
                      <h4 class="mt-4 max-w-xs font-display text-xl font-extrabold leading-[1.1] tracking-[-0.05em] text-slate-950 sm:text-2xl"><%= service.title %></h4>
                      <span class="mt-4 inline-flex items-center gap-1.5 text-xs font-medium text-gray-500">
                        <svg aria-hidden="true" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <circle cx="12" cy="12" r="9"></circle>
                          <path d="M12 7v5l3 2"></path>
                        </svg>
                        Entrega en <%= service.time %>
                      </span>
                      <div class="mt-8">
                        <span class="font-display text-4xl font-semibold leading-none tracking-[-0.08em] text-ink"><%= service.price %>€</span>
                      </div>
                      <a
                        class="service-action mt-7 inline-flex items-center gap-2 self-start rounded-lg bg-gray-100 px-4 py-2.5 text-sm font-bold text-ink transition-all hover:bg-gray-200 hover:shadow-sm"
                        href="/servicios/<%= service.slug %>"
                        data-service="<%= service.title %>"
                        aria-label="Ver detalles de <%= service.title %>"
                      >
                        Solicitar
                        <span aria-hidden="true" class="text-base leading-none transition-transform group-hover:translate-x-0.5">→</span>
                      </a>
                    </article>
                  <% }) %>
                </div>
              </section>
            <% }) %>
          </div>
        </section>

         <section id="como-funciona" class="border-y border-ink/10 bg-white/60">
          <div class="mx-auto grid max-w-7xl gap-12 px-6 py-20 lg:grid-cols-[0.7fr_1fr] lg:px-10 lg:py-24">
            <div>
              <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-lime-500">Así de fácil</p>
              <h2 class="font-display text-4xl font-extrabold leading-[1] tracking-[-0.06em] text-slate-950 sm:text-5xl">De idea a listo,<br /><span class="text-lime-500">sin escalas.</span></h2>
            </div>
            <div class="grid gap-8 sm:grid-cols-3">
              <div class="process-step"><span>01</span><h3>Elige</h3><p>Selecciona la solución que encaja con tu momento.</p></div>
              <div class="process-step"><span>02</span><h3>Conecta</h3><p>Cuéntanos lo imprescindible para arrancar.</p></div>
              <div class="process-step"><span>03</span><h3>Activa</h3><p>Recibe tu entrega lista para usar en 24–48h.</p></div>
            </div>
          </div>
        </section>

        <section id="solicitar" class="mx-auto max-w-7xl scroll-mt-8 px-6 py-20 lg:px-10 lg:py-28">
           <div class="request-panel relative overflow-hidden rounded-3xl bg-slate-950 px-7 py-10 text-white sm:px-12 sm:py-14 lg:px-16">
            <div class="relative z-10 max-w-2xl">
              <p class="mb-4 text-xs font-bold uppercase tracking-[0.2em] text-lime-500">¿Listo para empezar?</p>
              <h2 class="font-display text-4xl font-extrabold leading-none tracking-[-0.065em] sm:text-6xl">Hagamos que avance.</h2>
              <p class="mt-5 max-w-lg text-base leading-7 text-white/60">Selecciona un servicio arriba y escríbenos. Te responderemos con los siguientes pasos.</p>
              <a id="request-link" href="mailto:hola@conexa.es?subject=Quiero%20avanzar%20con%20CONEXA" class="mt-8 inline-flex items-center gap-3 rounded-full bg-lime-400 px-6 py-3.5 text-sm font-bold text-slate-950 transition-all hover:-translate-y-1 hover:bg-lime-500">
                Solicitar un servicio <span aria-hidden="true">↗</span>
              </a>
            </div>
            <div class="request-shape request-shape-one"></div>
            <div class="request-shape request-shape-two"></div>
          </div>
        </section>
      </main>

      <%- include("partials/footer") %>
    </div>
    <script>
      document.querySelectorAll("[data-service]").forEach((button) => {
        button.addEventListener("click", () => {
          const subject = encodeURIComponent(`Quiero solicitar: ${button.dataset.service}`);
          const requestLink = document.querySelector("#request-link");
          if (requestLink) requestLink.href = `mailto:hola@conexa.es?subject=${subject}`;
        });
      });

      document.querySelectorAll(".service-grid").forEach((slider) => {
        let isDown = false;
        let startX = 0;
        let startScrollLeft = 0;

        slider.addEventListener("mousedown", (event) => {
          isDown = true;
          slider.classList.add("is-dragging");
          startX = event.pageX - slider.offsetLeft;
          startScrollLeft = slider.scrollLeft;
        });

        slider.addEventListener("mouseleave", () => {
          isDown = false;
          slider.classList.remove("is-dragging");
        });

        slider.addEventListener("mouseup", () => {
          isDown = false;
          slider.classList.remove("is-dragging");
        });

        slider.addEventListener("mousemove", (event) => {
          if (!isDown) return;
          event.preventDefault();
          const currentX = event.pageX - slider.offsetLeft;
          const distance = (currentX - startX) * 1.15;
          slider.scrollLeft = startScrollLeft - distance;
        });
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add("is-visible");
        });
      }, { threshold: 0.1 });
      document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
    </script>
  </body>
</html>
