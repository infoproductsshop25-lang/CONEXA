<!doctype html>
<html lang="es">
  <head>
    <link rel="preconnect" href="https://buy.stripe.com">
    <link rel="dns-prefetch" href="https://buy.stripe.com">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="<%= service.subtitle %>" />
    <meta name="theme-color" content="#020617" />
    <title><%= pageTitle %></title>
    <link rel="icon" href="/images/favicon.jpeg" type="image/jpeg" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap">
    <link rel="stylesheet" href="/css/styles.css" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ["DM Sans", "ui-sans-serif", "system-ui", "sans-serif"],
              display: ["Space Grotesk", "ui-sans-serif", "system-ui", "sans-serif"],
            },
            colors: {
              ink: "#020617",
              teal: "#84cc16",
              mist: "#f8fafc",
              coral: "#0f172a",
            },
          },
        },
      };
    </script>
  </head>

<style>
:root {
  color-scheme: light;
  --ink: #020617;
  --teal: #84cc16;
  --mist: #f8fafc;
  --coral: #0f172a;
}

html {
  scroll-behavior: smooth;
}

body {
  background:
    radial-gradient(circle at 83% 8%, rgba(132, 204, 22, 0.1), transparent 23rem),
    var(--mist);
}

.font-display {
  font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
}

.hero-orb::before {
  position: absolute;
  z-index: -1;
  top: 0;
  right: -9rem;
  width: 31rem;
  height: 31rem;
  border: 1px solid rgba(132, 204, 22, 0.18);
  border-radius: 999px;
  content: "";
}

.hero-orb::after {
  position: absolute;
  z-index: -1;
  top: 5rem;
  right: -3rem;
  width: 18rem;
  height: 18rem;
  border-radius: 999px;
  background: rgba(132, 204, 22, 0.1);
  content: "";
}

.hero-note {
  width: 270px;
  min-height: 315px;
  padding: 1.3rem;
  border: 1px solid rgba(11, 31, 51, 0.1);
  border-radius: 1.25rem;
  background: rgba(255, 255, 255, 0.55);
  box-shadow: 0 25px 80px rgba(11, 31, 51, 0.08);
  transform: rotate(4deg);
}

.catalog-section {
  padding: 1.25rem;
  border: 1px solid rgba(11, 31, 51, 0.06);
  border-radius: 1.75rem;
}

.catalog-section--web {
  background: rgba(255, 255, 255, 0.72);
}

.catalog-section--growth {
  background: rgba(249, 250, 250, 0.9);
}

.catalog-section--brand {
  background: rgba(239, 249, 247, 0.72);
}

.catalog-section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1rem;
  padding: 0.25rem 0.25rem 0.75rem;
}

.section-number {
  display: inline-flex;
  height: 2.5rem;
  width: 2.5rem;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 0.75rem;
  background: var(--ink);
  color: white;
  font-family: "Space Grotesk", sans-serif;
  font-size: 0.9rem;
  font-weight: 600;
}

.service-grid {
  display: flex;
  gap: 0.75rem;
  overflow-x: auto;
  padding: 0.15rem 0.15rem 0.5rem;
  cursor: grab;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
}

.service-grid.is-dragging {
  cursor: grabbing;
  user-select: none;
}

.service-grid::-webkit-scrollbar {
  display: none;
}

.service-card {
  display: flex;
  min-height: 286px;
  min-width: calc(100% - 2.75rem);
  flex-direction: column;
  justify-content: space-between;
  padding: 1rem;
  border-radius: 1.25rem;
  background: rgba(255, 255, 255, 0.6);
  scroll-snap-align: start;
  transition: transform 300ms ease, box-shadow 300ms ease, background 300ms ease;
}

.service-card:hover {
  background: #fff;
  transform: translateY(-5px);
}

.tier-dot {
  display: block;
  height: 0.55rem;
  width: 0.55rem;
  flex: 0 0 auto;
  border-radius: 999px;
}

.tier-bajo,
.tier-medio,
.tier-alto { background: var(--teal); }

.process-step span {
  display: block;
  margin-bottom: 1.6rem;
  color: var(--teal);
  font-family: "Space Grotesk", sans-serif;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.process-step h3 {
  margin-bottom: 0.5rem;
  font-family: "Space Grotesk", sans-serif;
  font-size: 1.25rem;
  font-weight: 600;
  letter-spacing: -0.04em;
}

.process-step p {
  max-width: 13rem;
  color: rgba(11, 31, 51, 0.5);
  font-size: 0.875rem;
  line-height: 1.6;
}

.request-panel {
  box-shadow: 0 28px 80px rgba(11, 31, 51, 0.18);
}

.request-shape {
  position: absolute;
  border: 1px solid rgba(21, 184, 166, 0.45);
  border-radius: 999px;
}

.request-shape-one {
  right: -7rem;
  top: -9rem;
  height: 30rem;
  width: 30rem;
}

.request-shape-two {
  bottom: -10rem;
  right: 8rem;
  height: 22rem;
  width: 22rem;
  border-color: rgba(15, 23, 42, 0.45);
}

.reveal {
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 700ms ease, transform 700ms ease;
}

.reveal.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.service-card.reveal.is-visible {
  transition-delay: var(--delay, 0ms);
}

.reveal-delay {
  transition-delay: 160ms;
}

.legal-content .eyebrow {
  margin-bottom: 1rem;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.legal-content h1 {
  max-width: 46rem;
  margin: 0;
  font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
  font-size: clamp(2.7rem, 7vw, 5rem);
  font-weight: 600;
  line-height: 0.98;
  letter-spacing: -0.07em;
}

.legal-content .legal-intro {
  margin-top: 1.5rem;
  max-width: 40rem;
  color: rgba(11, 31, 51, 0.62);
  font-size: 1.15rem;
  line-height: 1.8;
}

.legal-content h2 {
  margin-top: 3rem;
  margin-bottom: 0.8rem;
  font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
  font-size: 1.45rem;
  font-weight: 600;
  letter-spacing: -0.04em;
}

.legal-content p,
.legal-content li {
  color: rgba(11, 31, 51, 0.68);
  font-size: 1rem;
  line-height: 1.8;
}

.legal-content p + p {
  margin-top: 0.9rem;
}

.legal-content ul {
  display: grid;
  gap: 0.7rem;
  margin-top: 1rem;
  padding-left: 1.25rem;
}

.legal-content li {
  padding-left: 0.25rem;
}

.legal-content li::marker {
  color: var(--teal);
}

.legal-content a {
  color: var(--teal);
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 0.2em;
}

.eyebrow {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.about-method-card {
  min-height: 260px;
  padding: 1.5rem;
  border: 1px solid rgba(11, 31, 51, 0.08);
  border-radius: 1.5rem;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18px 50px rgba(11, 31, 51, 0.05);
}

.about-method-card:nth-child(2) {
  background: rgba(239, 249, 247, 0.72);
}

.about-method-card:nth-child(3) {
  background: rgba(247, 254, 231, 0.86);
}

.about-method-card__number {
  display: block;
  margin-bottom: 3.5rem;
  color: var(--teal);
  font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.about-method-card h3 {
  margin-bottom: 0.6rem;
  font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
  font-size: 1.45rem;
  font-weight: 600;
  letter-spacing: -0.04em;
}

.about-method-card p {
  max-width: 18rem;
  color: rgba(11, 31, 51, 0.58);
  font-size: 0.95rem;
  line-height: 1.65;
}

.success-shell {
  position: relative;
}

.success-shell::before {
  position: absolute;
  z-index: -1;
  top: -7rem;
  right: -14rem;
  height: 30rem;
  width: 30rem;
  border: 1px solid rgba(21, 184, 166, 0.14);
  border-radius: 999px;
  content: "";
}

.success-check {
  display: inline-flex;
  height: 5rem;
  width: 5rem;
  align-items: center;
  justify-content: center;
  border-radius: 1.5rem;
  background: var(--teal);
  color: var(--ink);
  font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
  font-size: 2.5rem;
  font-weight: 700;
  box-shadow: 0 16px 40px rgba(21, 184, 166, 0.22);
}

.success-message {
  max-width: 38rem;
  padding: 1.25rem 1.5rem;
  border-left: 4px solid var(--teal);
  border-radius: 0 1rem 1rem 0;
  background: rgba(255, 255, 255, 0.7);
  color: rgba(11, 31, 51, 0.7);
  font-size: 1.15rem;
  line-height: 1.8;
}

.success-step {
  display: grid;
  grid-template-columns: 2.5rem 1fr;
  gap: 1rem;
  align-items: start;
  padding: 1.15rem 0;
  border-bottom: 1px solid rgba(11, 31, 51, 0.08);
}

.success-step span {
  color: var(--teal);
  font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.1em;
}

.success-step p {
  color: rgba(11, 31, 51, 0.68);
  font-size: 1rem;
  line-height: 1.7;
}

@media (min-width: 1024px) {
  .catalog-section {
    padding: 1.5rem;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: visible;
    padding: 0.15rem;
  }

  .service-card {
    min-width: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .reveal { opacity: 1; transform: none; transition: none; }
  .service-card, .service-action { transition: none; }
}
</style>

  </head>
  <body class="bg-mist text-slate-950 antialiased">
    <header class="sticky top-0 z-50 border-b border-ink/5 bg-mist/90 backdrop-blur-md">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10">
        <a href="/" class="group inline-flex items-center gap-3" aria-label="CONEXA, inicio">
  <img 
    src="/images/logo-conexa.webp" 
    alt="CONEXA Logo" 
    width="120" 
    height="65" 
    fetchpriority="high"
    class="h-8 md:h-10 w-auto mix-blend-multiply" 
  />
        </a>
        <a href="/#servicios" class="inline-flex items-center gap-2 text-sm font-semibold text-ink/60 transition-colors hover:text-ink">
          <span aria-hidden="true">←</span> Volver al catálogo
        </a>
      </nav>
    </header>

    <main class="mx-auto max-w-7xl px-6 py-14 lg:px-10 lg:py-24">
      <a href="/#servicios" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-lime-500">
        <span aria-hidden="true">←</span> Catálogo exprés
      </a>
      <div class="mt-8 grid gap-12 lg:grid-cols-[1fr_0.62fr] lg:items-start">
        <section>
          <div class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.18em] text-ink/45">
            <span class="tier-dot tier-<%= service.tier.toLowerCase() %>"></span>
            <%= service.category %> · Nivel <%= service.tier %>
          </div>
          <h1 class="mt-6 max-w-3xl font-display text-5xl font-extrabold leading-[0.98] tracking-[-0.07em] text-slate-950 sm:text-7xl"><%= service.title %></h1>
          <p class="mt-7 max-w-2xl text-xl leading-8 text-ink/60"><%= service.subtitle %></p>
          <div class="mt-9 flex flex-wrap items-center gap-4">
            <span class="font-display text-5xl font-semibold tracking-[-0.08em]"><%= service.price %>€</span>
            <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-gray-500 shadow-sm">
                <svg aria-hidden="true" class="h-4 w-4 text-lime-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>
              </svg>
              Entrega en <%= service.time %>
            </span>
          </div>
        </section>

        <aside class="service-detail-card rounded-3xl bg-slate-950 p-7 text-white shadow-xl shadow-ink/10 sm:p-9">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-lime-500">El problema</p>
          <p class="mt-5 text-lg leading-8 text-white/75"><%= service.problem %></p>
          <a
            href="<%= service.stripeUrl %>"
            rel="noopener noreferrer"
            class="mt-8 inline-flex items-center gap-3 rounded-full bg-lime-400 px-6 py-3.5 text-sm font-bold text-slate-950 transition-all hover:-translate-y-1 hover:bg-lime-500"
          >
            Contratar <%= service.title %> · <%= service.price %> € <span aria-hidden="true">↗</span>
          </a>
        </aside>
      </div>

      <section class="mt-20 border-t border-ink/10 pt-10">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-lime-500">Lo que incluye</p>
        <h2 class="mt-3 font-display text-3xl font-extrabold tracking-[-0.055em] text-slate-950 sm:text-4xl">Todo lo necesario para activarlo.</h2>
        <ul class="mt-8 grid gap-4 md:grid-cols-2">
          <% service.solution.forEach((item) => { %>
            <li class="flex gap-4 rounded-2xl border border-gray-200 bg-white/70 p-5 text-base leading-7 text-ink/70 shadow-sm">
              <span class="mt-1.5 h-2 w-2 flex-none rounded-full bg-lime-500"></span>
              <span><%= item %></span>
            </li>
          <% }) %>
        </ul>
      </section>
    </main>

    <%- include("partials/footer") %>
  </body>
</html>
