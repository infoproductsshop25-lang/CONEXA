<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="<%= service.subtitle %>" />
    <meta name="theme-color" content="#0b1f33" />
    <title><%= pageTitle %></title>
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ["DM Sans", "ui-sans-serif", "system-ui", "sans-serif"],
              display: ["Space Grotesk", "ui-sans-serif", "system-ui", "sans-serif"],
            },
            colors: {
              ink: "#0b1f33",
              teal: "#15b8a6",
              mist: "#f4f8f8",
              coral: "#ff735c",
            },
          },
        },
      };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="bg-mist text-ink antialiased">
    <header class="sticky top-0 z-50 border-b border-ink/5 bg-mist/90 backdrop-blur-md">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10">
        <a href="/" class="group inline-flex items-center gap-3" aria-label="CONEXA, inicio">
          <span class="logo-mark" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="font-display text-xl font-bold tracking-[-0.06em]">CONEXA</span>
        </a>
        <a href="/#servicios" class="inline-flex items-center gap-2 text-sm font-semibold text-ink/60 transition-colors hover:text-ink">
          <span aria-hidden="true">←</span> Volver al catálogo
        </a>
      </nav>
    </header>

    <main class="mx-auto max-w-7xl px-6 py-14 lg:px-10 lg:py-24">
      <a href="/#servicios" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-teal">
        <span aria-hidden="true">←</span> Catálogo exprés
      </a>
      <div class="mt-8 grid gap-12 lg:grid-cols-[1fr_0.62fr] lg:items-start">
        <section>
          <div class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.18em] text-ink/45">
            <span class="tier-dot tier-<%= service.tier.toLowerCase() %>"></span>
            <%= service.category %> · Nivel <%= service.tier %>
          </div>
          <h1 class="mt-6 max-w-3xl font-display text-5xl font-semibold leading-[0.98] tracking-[-0.07em] sm:text-7xl"><%= service.title %></h1>
          <p class="mt-7 max-w-2xl text-xl leading-8 text-ink/60"><%= service.subtitle %></p>
          <div class="mt-9 flex flex-wrap items-center gap-4">
            <span class="font-display text-5xl font-semibold tracking-[-0.08em]"><%= service.price %>€</span>
            <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-gray-500 shadow-sm">
              <svg aria-hidden="true" class="h-4 w-4 text-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>
              </svg>
              Entrega en <%= service.time %>
            </span>
          </div>
        </section>

        <aside class="service-detail-card rounded-3xl bg-ink p-7 text-white shadow-xl shadow-ink/10 sm:p-9">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-teal">Qué resolvemos</p>
          <p class="mt-5 text-lg leading-8 text-white/75"><%= service.problem %></p>
          <a
            href="mailto:hola@conexa.es?subject=<%= encodeURIComponent(`Quiero solicitar: ${service.title}`) %>"
            class="mt-8 inline-flex items-center gap-3 rounded-full bg-teal px-6 py-3.5 text-sm font-bold text-ink transition-transform hover:-translate-y-1"
          >
            Solicitar este servicio <span aria-hidden="true">↗</span>
          </a>
        </aside>
      </div>

      <section class="mt-20 border-t border-ink/10 pt-10">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-coral">Incluye</p>
        <h2 class="mt-3 font-display text-3xl font-semibold tracking-[-0.055em] sm:text-4xl">Todo lo necesario para activarlo.</h2>
        <ul class="mt-8 grid gap-4 md:grid-cols-2">
          <% service.solution.forEach((item) => { %>
            <li class="flex gap-4 rounded-2xl border border-gray-200 bg-white/70 p-5 text-base leading-7 text-ink/70 shadow-sm">
              <span class="mt-1.5 h-2 w-2 flex-none rounded-full bg-teal"></span>
              <span><%= item %></span>
            </li>
          <% }) %>
        </ul>
      </section>
    </main>

    <%- include("partials/footer") %>
  </body>
</html>