<!doctype html>
<html lang="es">
  <head>
<link rel="preconnect" href="https://buy.stripe.com">
<link rel="dns-prefetch" href="https://buy.stripe.com">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="<%= service.subtitle %>" />
    <meta name="theme-color" content="#020617" />
    <title><%= pageTitle %></title>
    <link rel="icon" href="/images/favicon.jpeg" type="image/jpeg" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ["DM Sans", "ui-sans-serif", "system-ui", "sans-serif"],
              display: ["Space Grotesk", "ui-sans-serif", "system-ui", "sans-serif"],
            },
            colors: {
              ink: "#020617",
              teal: "#84cc16",
              mist: "#f8fafc",
              coral: "#0f172a",
            },
          },
        },
      };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="bg-mist text-slate-950 antialiased">
    <header class="sticky top-0 z-50 border-b border-ink/5 bg-mist/90 backdrop-blur-md">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10">
        <a href="/" class="group inline-flex items-center gap-3" aria-label="CONEXA, inicio">
  <img 
    src="/images/logo-conexa.webp" 
    alt="CONEXA Logo" 
    width="120" 
    height="65" 
    class="h-8 md:h-10 w-auto mix-blend-multiply" 
  />
        </a>
        <a href="/#servicios" class="inline-flex items-center gap-2 text-sm font-semibold text-ink/60 transition-colors hover:text-ink">
          <span aria-hidden="true">←</span> Volver al catálogo
        </a>
      </nav>
    </header>

    <main class="mx-auto max-w-7xl px-6 py-14 lg:px-10 lg:py-24">
      <a href="/#servicios" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-lime-500">
        <span aria-hidden="true">←</span> Catálogo exprés
      </a>
      <div class="mt-8 grid gap-12 lg:grid-cols-[1fr_0.62fr] lg:items-start">
        <section>
          <div class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.18em] text-ink/45">
            <span class="tier-dot tier-<%= service.tier.toLowerCase() %>"></span>
            <%= service.category %> · Nivel <%= service.tier %>
          </div>
          <h1 class="mt-6 max-w-3xl font-display text-5xl font-extrabold leading-[0.98] tracking-[-0.07em] text-slate-950 sm:text-7xl"><%= service.title %></h1>
          <p class="mt-7 max-w-2xl text-xl leading-8 text-ink/60"><%= service.subtitle %></p>
          <div class="mt-9 flex flex-wrap items-center gap-4">
            <span class="font-display text-5xl font-semibold tracking-[-0.08em]"><%= service.price %>€</span>
            <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-gray-500 shadow-sm">
                <svg aria-hidden="true" class="h-4 w-4 text-lime-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>
              </svg>
              Entrega en <%= service.time %>
            </span>
          </div>
        </section>

        <aside class="service-detail-card rounded-3xl bg-slate-950 p-7 text-white shadow-xl shadow-ink/10 sm:p-9">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-lime-500">El problema</p>
          <p class="mt-5 text-lg leading-8 text-white/75"><%= service.problem %></p>
          <a
            href="<%= service.stripeUrl %>"
            rel="noopener noreferrer"
            class="mt-8 inline-flex items-center gap-3 rounded-full bg-lime-400 px-6 py-3.5 text-sm font-bold text-slate-950 transition-all hover:-translate-y-1 hover:bg-lime-500"
          >
            Contratar <%= service.title %> · <%= service.price %> € <span aria-hidden="true">↗</span>
          </a>
        </aside>
      </div>

      <section class="mt-20 border-t border-ink/10 pt-10">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-lime-500">Lo que incluye</p>
        <h2 class="mt-3 font-display text-3xl font-extrabold tracking-[-0.055em] text-slate-950 sm:text-4xl">Todo lo necesario para activarlo.</h2>
        <ul class="mt-8 grid gap-4 md:grid-cols-2">
          <% service.solution.forEach((item) => { %>
            <li class="flex gap-4 rounded-2xl border border-gray-200 bg-white/70 p-5 text-base leading-7 text-ink/70 shadow-sm">
              <span class="mt-1.5 h-2 w-2 flex-none rounded-full bg-lime-500"></span>
              <span><%= item %></span>
            </li>
          <% }) %>
        </ul>
      </section>
    </main>

    <%- include("partials/footer") %>
  </body>
</html>
